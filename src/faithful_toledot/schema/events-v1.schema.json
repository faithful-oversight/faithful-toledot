{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faithful-oversight.github.io/faithful-toledot/schema/events-v1.schema.json",
  "title": "toledot event collection, one line",
  "description": "Version 1 of the file written by the toledot collectors. The file is JSON Lines in UTF-8: the first line is a header, each following line is one event, and the last line is a trailer. Each line of the file matches this schema. `sha256` in the trailer is the SHA-256 of every byte before the trailer line, so a truncated or damaged file is detected; it does not prove who wrote the file. `toledot schema events` prints this schema offline.",
  "oneOf": [
    {"$ref": "#/$defs/header"},
    {"$ref": "#/$defs/event"},
    {"$ref": "#/$defs/trailer"}
  ],
  "$defs": {
    "time": {
      "description": "A UTC time: RFC 3339 with a Z suffix and up to seven fraction digits.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$"
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toledot_events", "collector", "collected_at", "computer", "query", "logs"],
      "properties": {
        "toledot_events": {"const": 1},
        "collector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "method"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 200},
            "version": {"type": "string", "minLength": 1, "maxLength": 50},
            "method": {"enum": ["powershell", "psrp"]}
          }
        },
        "collected_at": {"$ref": "#/$defs/time"},
        "computer": {"type": "string", "minLength": 1, "maxLength": 255},
        "operator": {"type": ["string", "null"], "maxLength": 512},
        "query": {
          "type": "object",
          "additionalProperties": false,
          "required": ["channels", "event_ids", "since", "until"],
          "properties": {
            "channels": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {"type": "string", "minLength": 1, "maxLength": 255}
            },
            "event_ids": {
              "description": "The event IDs asked for. An empty list means every event in the period.",
              "type": "array",
              "maxItems": 1000,
              "items": {"type": "integer", "minimum": 0, "maximum": 65535}
            },
            "since": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
            "until": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]}
          }
        },
        "logs": {
          "description": "Each log as it stood when it was read.",
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel", "oldest_record_id", "oldest_time", "newest_record_id", "record_count", "max_size_bytes", "mode"],
            "properties": {
              "channel": {"type": "string", "minLength": 1, "maxLength": 255},
              "oldest_record_id": {"type": ["integer", "null"], "minimum": 0},
              "oldest_time": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
              "newest_record_id": {"type": ["integer", "null"], "minimum": 0},
              "record_count": {"type": ["integer", "null"], "minimum": 0},
              "max_size_bytes": {"type": ["integer", "null"], "minimum": 0},
              "mode": {"enum": ["circular", "retain", "autobackup", "unknown"]}
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "event_id", "version", "time", "computer", "channel", "provider", "system", "data"],
      "properties": {
        "record_id": {"type": "integer", "minimum": 0},
        "event_id": {"type": "integer", "minimum": 0, "maximum": 65535},
        "version": {"type": "integer", "minimum": 0, "maximum": 255},
        "time": {"$ref": "#/$defs/time"},
        "computer": {"type": "string", "minLength": 1, "maxLength": 255},
        "channel": {"type": "string", "minLength": 1, "maxLength": 255},
        "provider": {"type": "string", "maxLength": 255},
        "system": {
          "description": "Other System fields, by element name, as text.",
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {"type": "string", "maxLength": 1024}
        },
        "data": {
          "description": "The EventData fields in order, each exactly as the event's XML holds it.",
          "type": "object",
          "maxProperties": 256,
          "additionalProperties": {"type": "string", "maxLength": 1048576}
        }
      }
    },
    "trailer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["end", "events", "sha256", "gaps"],
      "properties": {
        "end": {"const": true},
        "events": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gaps": {
          "description": "What the collector could not read, and why.",
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["area", "reason"],
            "properties": {
              "area": {"type": "string", "minLength": 1, "maxLength": 255},
              "reason": {"type": "string", "minLength": 1, "maxLength": 4096}
            }
          }
        }
      }
    }
  }
}
