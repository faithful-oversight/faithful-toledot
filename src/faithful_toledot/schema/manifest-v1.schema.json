{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "tool",
    "generated_at",
    "files",
    "inputs"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "toledot"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "generated_at": {
      "$ref": "#/$defs/time"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "size",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^toledot-[a-z]+\\.[a-z]+$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "size",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "$id": "https://faithful-oversight.github.io/faithful-toledot/schema/manifest-v1.schema.json",
  "title": "toledot run manifest",
  "description": "Version 1 of the manifest toledot writes with every run. It lists each report file with its size and SHA-256, and each input, so a reader can confirm that a set of files is complete and unchanged. The manifest is placed last.",
  "$defs": {
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "format": "date-time",
      "description": "RFC 3339, UTC, with a trailing Z. Fractional seconds appear only when they are not zero."
    }
  }
}
